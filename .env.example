# Shared by both the registration service and the cronjob
PRICEWATCH_API_KEY=change-me

# AWS / S3 — both pieces read and write the same bucket
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET_NAME=pricewatch-data

# Registration service
PORT=3001

# Cronjob email (owner alerts + subscriber-removed notices)
APP_NAME=PriceWatch
EMAIL_FROM_ADDRESS=you@gmail.com
EMAIL_TO=you@gmail.com
EMAIL_USER=you@gmail.com
EMAIL_PASSWORD=your16charapppassword
