# Server mode: full (webhooks) or catalog (read-only GET /prices)
# PRICEWATCH_MODE=full

# Server
PORT=3001

# Catalog mode defaults: PORT=7000, PRICEWATCH_MODE=catalog
# Comma-separated vendors to fetch and expose (catalog only; default = all):
# CATALOG_PROVIDERS=openai,anthropic,gemini,meta,mistral,deepseek,qwen,xai,cohere,perplexity,amazon
# REFRESH_INTERVAL_SEC=3600
# HTTP_TIMEOUT_MS=30000
# USER_AGENT=PriceWatch-Catalog/1.0

# Data directory for JSON state (subscribers, retry queue, baseline)
DATA_DIR=.

# Set to "true" only for local testing to allow webhook URLs on localhost/private IPs
ALLOW_PRIVATE_URLS=false
