# Dependency-free catalog image: Node stdlib + in-repo JS only (~smallest RSS/CPU).
FROM node:22-alpine

WORKDIR /app

COPY env-config.js pricing.js catalog.js catalog-server.js ./

ENV NODE_ENV=production
ENV NODE_OPTIONS=--max-old-space-size=64
ENV PRICEWATCH_MODE=catalog
ENV PORT=7000
ENV REFRESH_INTERVAL_SEC=3600

EXPOSE 7000

USER node

CMD ["node", "catalog-server.js"]
